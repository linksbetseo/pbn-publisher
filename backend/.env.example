OPENAI_API_KEY=sk-...
CSV_PATH=/path/to/domains.csv
DB_PATH=pbn_publisher.db

# Authentication
APP_USER=admin
APP_PASSWORD=change-me-in-production
CRON_SECRET=

# Encryption key for WordPress passwords (generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
PBN_ENCRYPTION_KEY=

# DataForSEO (optional — enables SERP analysis)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# AI image generation (optional)
GEMINI_API_KEY=

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CORS (comma-separated origins, default * = all)
CORS_ORIGINS=*

# GPT model override (default: gpt-4o-mini)
GPT_MODEL=gpt-4o-mini
